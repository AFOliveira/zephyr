config SOC_ETSOC1_MINION_UMODE
	select RISCV
	select RISCV_ISA_RV64I
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_D
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select 64BIT
	select RISCV_RUN_IN_UMODE
	# U-mode kernel: we do not select RISCV_PRIVILEGED (no mstatus/mtvec
	# writes), no INCLUDE_RESET_VECTOR (our entry is _start), no PLIC or
	# machine timer.
